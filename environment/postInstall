echo "Installing Claude CLI..."

# Keep Claude data under capsule storage, not main workstation disk.
# This directory will be owned by claude-user (see FIX #2 below).
mkdir -p /root/capsule/.claude

# Root shell convenience â append to .bashrc only once
if ! grep -q 'CLAUDE_CONFIG_DIR=/root/capsule/.claude' /root/.bashrc 2>/dev/null; then
cat >> /root/.bashrc <<'EOF'

# Claude config + logs in capsule storage
export CLAUDE_CONFIG_DIR=/root/capsule/.claude
export PATH="/root/.local/bin:/usr/local/bin:/opt/conda/bin:$PATH"
EOF
fi

# Keep temp/cache OFF the tiny 5 GB "/" overlay (filling it locks the environment).
# This applies to ANY process launched from a terminal â e.g. GUI apps the user
# starts with `python -m ...`, which may not inherit the coding agent's environment.
# (See code/AGENTS.md "Core rules".)
if ! grep -q 'TMPDIR=/scratch/tmp' /root/.bashrc 2>/dev/null; then
cat >> /root/.bashrc <<'EOF'

# Redirect temp/cache onto /scratch (8 EB) - never /tmp or / (5 GB overlay)
export TMPDIR=/scratch/tmp
export TEMP=/scratch/tmp
export TMP=/scratch/tmp
export MPLCONFIGDIR=/scratch/tmp/mplconfig
export PIP_CACHE_DIR=/scratch/tmp/pip-cache
mkdir -p /scratch/tmp/mplconfig /scratch/tmp/pip-cache 2>/dev/null
EOF
fi

# Export for the remainder of this script (curl installer needs PATH)
export CLAUDE_CONFIG_DIR=/root/capsule/.claude
export PATH="/root/.local/bin:/usr/local/bin:/opt/conda/bin:$PATH"

curl -fsSL https://claude.ai/install.sh | bash

echo "Claude installation complete."
echo "Claude data dir: /root/capsule/.claude"


# Setting up aliases
if ! grep -q 'alias claude-skip=' /root/.bashrc 2>/dev/null; then
cat >> /root/.bashrc <<'EOF'

alias claude-skip='cd /root/capsule && IS_SANDBOX=1 claude --dangerously-skip-permissions'
alias startcapsule='bash /root/capsule/environment/start.sh'
alias cleanupdisk='bash /root/capsule/environment/cleanup_disk.sh'

EOF
fi
