cd / && git clone https://github.com/jkim0731/claude-code-skills-misc
cd / && git clone https://github.com/AllenNeuralDynamics/comb
cd /comb && git checkout for_gcamp_validation && pip install -e . --no-cache-dir
cd / && git clone https://github.com/AllenNeuralDynamics/lamf-analysis
cd /lamf-analysis && pip install -e . --no-cache-dir

